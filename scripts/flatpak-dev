#!/usr/bin/env bash
set -euo pipefail

readonly PROJECT_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
readonly PROJECT_NAME="$(basename "$PROJECT_ROOT")"
readonly PROJECT_SLUG="${PROJECT_NAME//[^a-zA-Z0-9_.-]/-}"
readonly APP_ID="${FLATPAK_DEV_APP_ID:-io.github.example.TemplateApp}"
readonly SSH_HOST="${FLATPAK_DEV_SSH_HOST:-$PROJECT_SLUG-flatpak}"
readonly SERVICE_NAME="flatpak-dev-$PROJECT_SLUG.service"
readonly STATE_DIR="$PROJECT_ROOT/.flatpak-dev"
readonly SSH_DIR="$STATE_DIR/ssh"
readonly DEV_HOME="$STATE_DIR/home"
readonly BUILD_DIR="$STATE_DIR/build"
readonly MANIFEST="$PROJECT_ROOT/flatpak/io.github.example.TemplateApp.dev.yml"
readonly PORT="${FLATPAK_DEV_SSH_PORT:-22222}"
readonly START_TIMEOUT="${FLATPAK_DEV_SSH_START_TIMEOUT:-1800}"
readonly CONNECTION_TIMEOUT="${FLATPAK_DEV_SSH_CONNECTION_TIMEOUT:-120}"
readonly IDLE_TIMEOUT="${FLATPAK_DEV_SSH_IDLE_TIMEOUT:-30}"
readonly DEV_PATH="/app/bin:/usr/bin"
readonly SANDBOX_HOME="$HOME/.var/app/$APP_ID"
readonly SSHD_LOG="$SSH_DIR/sshd.log"

server_pid=""

require_command() {
    if command -v "$1" >/dev/null 2>&1; then
        return
    fi

    echo "Missing required host command: $1" >&2
    exit 1
}

validate_settings() {
    if [[ ! "$PORT" =~ ^[0-9]+$ ]] || ((10#$PORT < 1 || 10#$PORT > 65535)); then
        echo "FLATPAK_DEV_SSH_PORT must be a number from 1 through 65535." >&2
        exit 1
    fi

    local name
    for name in START_TIMEOUT CONNECTION_TIMEOUT IDLE_TIMEOUT; do
        if [[ ! "${!name}" =~ ^[0-9]+$ ]] || ((10#${!name} < 1)); then
            echo "$name must be a positive number of seconds." >&2
            exit 1
        fi
    done
}

port_is_listening() {
    ss -H -ltn "sport = :$PORT" | read -r _
}

ssh_is_ready() {
    if [[ ! -f "$SSH_DIR/config" ]]; then
        return 1
    fi

    ssh \
        -F "$SSH_DIR/config" \
        -p "$PORT" \
        -o BatchMode=yes \
        -o ConnectTimeout=2 \
        "$SSH_HOST" \
        true \
        </dev/null \
        >/dev/null \
        2>&1
}

print_connection_details() {
    cat <<EOF

The project's development Flatpak is ready.

Add this line to ~/.ssh/config once:
    Include $SSH_DIR/config

Then connect to "$SSH_HOST" with VS Code Remote-SSH.
Open this workspace after connecting:
    $PROJECT_ROOT
EOF
}

cleanup() {
    if [[ -z "$server_pid" ]]; then
        return
    fi

    if kill -0 "$server_pid" 2>/dev/null; then
        kill "$server_pid" 2>/dev/null || true
        wait "$server_pid" 2>/dev/null || true
    fi
}

ssh_connection_is_active() {
    local _
    while read -r _; do
        return 0
    done < <(ss -H -tn state established "sport = :$PORT")

    return 1
}

service_is_active() {
    systemctl --user is-active --quiet "$SERVICE_NAME"
}

show_service_logs() {
    journalctl --user -u "$SERVICE_NAME" --no-pager -n 40
}

write_dev_profile() {
    mkdir -p "$DEV_HOME"
    chmod 700 "$DEV_HOME"

    cat > "$DEV_HOME/.profile" <<EOF
export PATH="$DEV_PATH"
EOF
    chmod 600 "$DEV_HOME/.profile"
}

run_command() {
    require_command flatpak-builder

    if (($# == 0)); then
        echo "Usage: $0 run <command> [args...]" >&2
        exit 2
    fi

    if [[ ! -d "$BUILD_DIR/files" ]]; then
        echo "The development Flatpak has not been built. Run '$0 start' first." >&2
        exit 1
    fi

    write_dev_profile

    flatpak-builder \
        --run \
        --filesystem="$PROJECT_ROOT" \
        "$BUILD_DIR" \
        "$MANIFEST" \
        env \
        "HOME=$DEV_HOME" \
        "FLATPAK_DEV_PROJECT_ROOT=$PROJECT_ROOT" \
        /bin/sh \
        -c '. "$HOME/.profile"; cd "$FLATPAK_DEV_PROJECT_ROOT"; exec "$@"' \
        sh \
        "$@"
}

start_service() {
    require_command systemctl
    require_command systemd-run
    require_command ssh
    require_command ss
    validate_settings

    if ! service_is_active; then
        if port_is_listening; then
            echo "Port $PORT is already in use. Nothing was stopped." >&2
            echo "Close the process using it or set FLATPAK_DEV_SSH_PORT to another port." >&2
            exit 1
        fi

        systemctl --user reset-failed "$SERVICE_NAME" 2>/dev/null || true

        local systemd_args=(
            --user
            --unit="$SERVICE_NAME"
            --collect
            --property=Type=exec
            --working-directory="$PROJECT_ROOT"
            --setenv="FLATPAK_DEV_APP_ID=$APP_ID"
            --setenv="FLATPAK_DEV_SSH_HOST=$SSH_HOST"
            --setenv="FLATPAK_DEV_SSH_PORT=$PORT"
            --setenv="FLATPAK_DEV_SSH_CONNECTION_TIMEOUT=$CONNECTION_TIMEOUT"
            --setenv="FLATPAK_DEV_SSH_IDLE_TIMEOUT=$IDLE_TIMEOUT"
        )

        local name
        for name in DISPLAY WAYLAND_DISPLAY XDG_RUNTIME_DIR DBUS_SESSION_BUS_ADDRESS; do
            if [[ -v "$name" ]]; then
                systemd_args+=(--setenv="$name=${!name}")
            fi
        done

        systemd-run "${systemd_args[@]}" "$PROJECT_ROOT/scripts/flatpak-dev" serve
    fi

    local deadline=$((SECONDS + START_TIMEOUT))
    local next_update=$((SECONDS + 10))
    while ((SECONDS < deadline)); do
        if ssh_is_ready; then
            print_connection_details
            return
        fi

        if ! service_is_active; then
            echo "The Flatpak development service exited before SSH became ready:" >&2
            show_service_logs >&2
            exit 1
        fi

        if ((SECONDS >= next_update)); then
            echo "The Flatpak build is still running. Use '$0 logs' to see its output."
            next_update=$((SECONDS + 10))
        fi

        sleep 0.5
    done

    echo "The Flatpak development service did not become ready within $START_TIMEOUT seconds." >&2
    show_service_logs >&2
    exit 1
}

stop_service() {
    require_command systemctl

    if ! service_is_active; then
        echo "The Flatpak development service is not running."
        return
    fi

    systemctl --user stop "$SERVICE_NAME"
    echo "The Flatpak development service stopped."
}

case "${1:-start}" in
    start)
        start_service
        exit
        ;;
    stop)
        stop_service
        exit
        ;;
    status)
        require_command systemctl
        systemctl --user status "$SERVICE_NAME" --no-pager
        exit
        ;;
    logs)
        require_command journalctl
        journalctl --user -u "$SERVICE_NAME" -f
        exit
        ;;
    run)
        shift
        run_command "$@"
        exit
        ;;
    serve)
        ;;
    *)
        echo "Usage: $0 [start|stop|status|logs|run <command> [args...]]" >&2
        exit 2
        ;;
esac

require_command flatpak
require_command flatpak-builder
require_command ssh
require_command ssh-keygen
require_command ss
validate_settings

readonly FLATPAK_ARCH="$(flatpak --default-arch)"
readonly RUNTIME_LIBDIR="/usr/lib/$FLATPAK_ARCH-linux-gnu"

mkdir -p "$SSH_DIR"
chmod 700 "$SSH_DIR"
write_dev_profile

trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

if port_is_listening; then
    echo "Port $PORT is already in use. Nothing was stopped." >&2
    echo "Close the process using it or set FLATPAK_DEV_SSH_PORT to another port." >&2
    exit 1
fi

builder_args=(
    --user
    --force-clean
    --state-dir="$STATE_DIR/builder-state"
)

if [[ -d "$BUILD_DIR/files" ]]; then
    builder_args+=(--skip-if-unchanged)
fi

has_flatpak_ref() {
    flatpak info --user "$1" >/dev/null 2>&1 || flatpak info --system "$1" >/dev/null 2>&1
}

if ! has_flatpak_ref "org.freedesktop.Sdk//25.08"; then
    builder_args+=(--install-deps-from=flathub)
fi

if flatpak-builder "${builder_args[@]}" "$BUILD_DIR" "$MANIFEST"; then
    builder_status=0
else
    builder_status=$?
fi

if ((builder_status != 0 && builder_status != 42)); then
    exit "$builder_status"
fi

if [[ ! -f "$SSH_DIR/id_ed25519" ]]; then
    ssh-keygen -q -t ed25519 -N "" -C "Flatpak development" -f "$SSH_DIR/id_ed25519"
fi

if [[ ! -f "$SSH_DIR/ssh_host_ed25519_key" ]]; then
    ssh-keygen -q -t ed25519 -N "" -C "Flatpak SSH host" -f "$SSH_DIR/ssh_host_ed25519_key"
fi

cp "$SSH_DIR/id_ed25519.pub" "$SSH_DIR/authorized_keys"
chmod 600 "$SSH_DIR/id_ed25519" "$SSH_DIR/authorized_keys" "$SSH_DIR/ssh_host_ed25519_key"
chmod 644 "$SSH_DIR/id_ed25519.pub" "$SSH_DIR/ssh_host_ed25519_key.pub"

cat > "$SSH_DIR/sshd_config" <<EOF
Port $PORT
ListenAddress 127.0.0.1
HostKey $SSH_DIR/ssh_host_ed25519_key
AuthorizedKeysFile $SSH_DIR/authorized_keys
PidFile /tmp/flatpak-dev-sshd.pid
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitRootLogin no
AllowUsers $USER
StrictModes yes
AllowTcpForwarding yes
AllowAgentForwarding no
X11Forwarding no
PermitTunnel no
GatewayPorts no
UseDNS no
Subsystem sftp internal-sftp
SetEnv HOME=$DEV_HOME BASH_ENV=$DEV_HOME/.profile ENV=$DEV_HOME/.profile PATH=$DEV_PATH FLATPAK_ID=$APP_ID FLATPAK_ARCH=$FLATPAK_ARCH container=flatpak DBUS_SESSION_BUS_ADDRESS=unix:path=/run/flatpak/bus LD_LIBRARY_PATH=/app/lib:$RUNTIME_LIBDIR/GL/default/lib PKG_CONFIG_PATH=/app/lib/pkgconfig:/app/share/pkgconfig C_INCLUDE_PATH=/app/include CPLUS_INCLUDE_PATH=/app/include LDFLAGS=-L/app/lib WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-wayland-0} XDG_RUNTIME_DIR=/run/user/$(id -u) XDG_CACHE_HOME=$SANDBOX_HOME/cache XDG_CONFIG_HOME=$SANDBOX_HOME/config XDG_DATA_HOME=$SANDBOX_HOME/data XDG_STATE_HOME=$SANDBOX_HOME/.local/state XDG_CONFIG_DIRS=/app/etc/xdg:/etc/xdg XDG_DATA_DIRS=/app/share:/usr/share:/usr/share/runtime/share:/run/host/user-share:/run/host/share
EOF
chmod 600 "$SSH_DIR/sshd_config"

read -r host_key_type host_key_data _ < "$SSH_DIR/ssh_host_ed25519_key.pub"
printf '[127.0.0.1]:%s %s %s\n' "$PORT" "$host_key_type" "$host_key_data" > "$SSH_DIR/known_hosts"
chmod 600 "$SSH_DIR/known_hosts"

cat > "$SSH_DIR/config" <<EOF
Host $SSH_HOST
    HostName 127.0.0.1
    Port $PORT
    User $USER
    IdentityFile $SSH_DIR/id_ed25519
    IdentitiesOnly yes
    UserKnownHostsFile $SSH_DIR/known_hosts
    StrictHostKeyChecking yes
    PasswordAuthentication no
EOF
chmod 600 "$SSH_DIR/config"

: > "$SSHD_LOG"

# The Freedesktop SDK exceeds VS Code's runtime requirements, but VS Code's probe
# cannot find libstdc++ in the SDK's multiarch layout without an ld.so cache.
# This marker is VS Code's supported way for the host environment to skip it.
flatpak build \
    --die-with-parent \
    --readonly \
    --with-appdir \
    --talk-name=org.freedesktop.DBus \
    --filesystem="$PROJECT_ROOT" \
    "$BUILD_DIR" \
    /bin/sh \
    -c 'touch /tmp/vscode-skip-server-requirements-check && exec /app/sbin/sshd "$@"' \
    sh \
    -D \
    -e \
    -f "$SSH_DIR/sshd_config" \
    >"$SSHD_LOG" \
    2>&1 &
server_pid=$!

for _ in {1..50}; do
    if ssh_is_ready; then
        echo "The SSH server is listening on 127.0.0.1:$PORT."
        break
    fi

    if ! kill -0 "$server_pid" 2>/dev/null; then
        wait "$server_pid" || true
        server_pid=""
        echo "The Flatpak SSH server exited before it became ready:" >&2
        tail -n 30 "$SSHD_LOG" >&2
        exit 1
    fi

    sleep 0.1
done

if ! ssh_is_ready; then
    echo "The Flatpak SSH server did not become ready:" >&2
    tail -n 30 "$SSHD_LOG" >&2
    exit 1
fi

connection_started_at=0
disconnected_at=0
saw_stable_connection=0
startup_deadline=$((SECONDS + CONNECTION_TIMEOUT))

while kill -0 "$server_pid" 2>/dev/null; do
    if ssh_connection_is_active; then
        if ((connection_started_at == 0)); then
            connection_started_at=$SECONDS
        fi

        # Ignore the launcher's short readiness probes. A real Remote-SSH
        # management connection remains open for the life of the window.
        if ((SECONDS - connection_started_at >= 2)); then
            saw_stable_connection=1
            disconnected_at=0
        fi
    else
        connection_started_at=0

        if ((saw_stable_connection == 1 && disconnected_at == 0)); then
            disconnected_at=$SECONDS
        fi

        if ((saw_stable_connection == 0 && SECONDS >= startup_deadline)); then
            echo "No Remote-SSH connection arrived within $CONNECTION_TIMEOUT seconds."
            exit
        fi

        if ((disconnected_at > 0 && SECONDS - disconnected_at >= IDLE_TIMEOUT)); then
            echo "Remote-SSH disconnected for $IDLE_TIMEOUT seconds."
            exit
        fi
    fi

    sleep 1
done

server_status=0
if wait "$server_pid"; then
    server_status=0
else
    server_status=$?
fi
server_pid=""
exit "$server_status"
