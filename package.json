{
  "name": "gtkx-app",
  "version": "0.0.1",
  "private": true,
  "description": "A GTKX application",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "gtkx dev",
    "build": "gtkx build",
    "codegen": "gtkx codegen",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "gtkx codegen && tsc --noEmit",
    "start": "node dist/bundle.mjs",
    "test": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test --run"
  },
  "dependencies": {
    "@gtkx/cairo": "^1.6.0",
    "@gtkx/css": "^1.6.0",
    "@gtkx/native": "^1.6.0",
    "@gtkx/react": "^1.6.0",
    "@gtkx/runtime": "^1.6.0",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@gtkx/cli": "^1.6.0",
    "@gtkx/config": "^1.6.0",
    "@gtkx/testing": "^1.6.0",
    "@gtkx/vitest": "^1.6.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.23.0"
}
